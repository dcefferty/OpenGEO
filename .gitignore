# macOS
.DS_Store

# The held-out private split (ROADMAP item 10). Never commit anything under here:
# git history is permanent and carries this project's pre-registration evidence, so a
# private question committed once can never be made private again without rewriting the
# history that proves when each round was pre-registered. `check_private.py` enforces it.
private/

# Agent tool settings. These accumulate literal shell commands from approved tool calls,
# which have included API keys inline. Protected by a global ignore on this machine only,
# which does not travel with the repo -- so it is pinned here too.
.claude/settings.local.json
